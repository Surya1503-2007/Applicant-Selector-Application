{
  "name": "rac-drdo-adaptive-interview-system",
  "version": "1.0.0",
  "description": "RAC DRDO Adaptive Interview System - Root Project Workspace",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run start\" \"npm run client:dev\"",
    "start": "npm --prefix server start",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:preview": "npm --prefix client run preview",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:seed": "npm --prefix server run db:seed",
    "db:reset": "npm --prefix server run db:reset",
    "test:db": "npm --prefix server run test:db",
    "test:skillmatch": "npm --prefix server run test:skillmatch",
    "test:scorer": "npm --prefix server run test:scorer",
    "calibrate:scorer": "npm --prefix server run calibrate:scorer",
    "test:persistence": "npm --prefix server run test:persistence",
    "test:security": "node scripts/testCandidateProtection.js"
  },
  "keywords": [
    "drdo",
    "rac",
    "adaptive-interview",
    "skill-match"
  ],
  "author": "RAC DRDO Development Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
