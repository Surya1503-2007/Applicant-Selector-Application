// Prisma Schema for RAC DRDO Adaptive Interview System
// Parts 1-5 core, 7A auth, 7C expert questions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LevelTag {
  TECHNICAL
  MANAGERIAL
  ICEBREAKER
}

enum Role {
  ADMIN
  EXAMINER
}

// ===================== Part 1: Question bank =====================

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  topics    Topic[]
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Topic {
  id        String     @id @default(uuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([subjectId, name])
}

model Question {
  id             String     @id @default(uuid())
  topicId        String?
  topic          Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  difficulty     Difficulty
  questionText   String     @db.Text
  simplifiedText String?    @db.Text
  idealAnswer    String     @db.Text
  keywords       String[]
  parentQId      String?
  parentQuestion Question?  @relation("QuestionFollowUps", fields: [parentQId], references: [id], onDelete: SetNull)
  followUps      Question[] @relation("QuestionFollowUps")
  levelTag       LevelTag
  responses      Response[]
  // Part 7C
  source         String     @default("BANK") // BANK | EXPERT
  createdById    String?
  status         String     @default("ACTIVE") // ACTIVE | ARCHIVED
  aspectKeywords String[] // ice-breaker aspects (empty list if none)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([topicId, difficulty])
  @@index([parentQId])
  @@index([difficulty])
  @@index([levelTag])
}

model Candidate {
  id                String             @id @default(uuid())
  name              String
  postApplied       String
  experienceLevel   String
  sessions          Session[]
  skills            CandidateSkill[]
  skillMatchResults SkillMatchResult[]
  reports           Report[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Session {
  id              String           @id @default(uuid())
  candidateId     String
  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  startTime       DateTime         @default(now())
  endTime         DateTime?
  responses       Response[]
  sessionState    SessionState?
  decisionLogs    DecisionLog[]
  reports         Report[]
  candidateAccess CandidateAccess?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([candidateId])
}

model Response {
  id               String   @id @default(uuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerText       String   @db.Text
  relevancyScore   Float?
  correctnessScore Float?
  answerScore      Float?
  verdict          String?
  breakdown        Json?
  isReask          Boolean  @default(false)
  timestamp        DateTime @default(now())

  @@unique([sessionId, questionId, isReask])
  @@index([sessionId])
  @@index([questionId])
}

// ===================== Part 2: Skill match =====================

model Post {
  id                String             @id @default(uuid())
  title             String
  subjectId         String
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level             String
  postSkills        PostSkill[]
  skillMatchResults SkillMatchResult[]
  reports           Report[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([subjectId])
}

model PostSkill {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  skillName   String
  weight      Int
  isMandatory Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([postId, skillName])
  @@index([postId])
}

model CandidateSkill {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillName   String
  createdAt   DateTime  @default(now())

  @@unique([candidateId, skillName])
  @@index([candidateId])
}

model SkillMatchResult {
  id           String    @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  matchPercent Float
  band         String
  breakdown    Json
  createdAt    DateTime  @default(now())

  @@index([candidateId])
  @@index([postId])
}

// ===================== Part 4: Adaptive engine =====================

model SessionState {
  id                    String      @id @default(uuid())
  sessionId             String      @unique
  session               Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currentTopicId        String?
  currentDifficulty     Difficulty?
  currentQuestionId     String?
  phase                 String      @default("ICEBREAKER") // ICEBREAKER | TECHNICAL | COMPLETED
  technicalCount        Int         @default(0)
  icebreakerCount       Int         @default(0)
  consecutiveIrrelevant Int         @default(0)
  topicProgress         Json        @default("{}")
  status                String      @default("ACTIVE") // ACTIVE | COMPLETED
  endReason             String?
  expertQueue           Json? // Part 7C: ["questionId1", ...]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

model DecisionLog {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step           Int
  questionId     String?
  verdict        String?
  fromDifficulty String?
  toDifficulty   String?
  action         String
  reason         String   @db.Text
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, step])
}

// ===================== Part 5: Report =====================

model Report {
  id                     String    @id @default(uuid())
  sessionId              String
  session                Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidateId            String
  candidate              Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postId                 String
  post                   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  version                Int       @default(1)
  generatedAt            DateTime  @default(now())
  configSnapshot         Json
  skillMatchPercent      Float
  skillMatchBand         String
  mandatoryGap           Boolean
  missingMandatory       Json
  interviewScore         Float
  overallScore           Float
  systemRecommendation   String
  finalRecommendation    String
  terminatedEarly        Boolean   @default(false)
  endReason              String?
  questionRelevancyScore Float
  questionRelevancyBand  String
  topicScores            Json
  questionTable          Json
  difficultyProgression  Json
  flags                  Json
  decisionLog            Json
  boardRemarks           String?   @db.Text
  overriddenBy           String?
  overriddenAt           DateTime?
  overrideReason         String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([sessionId, version])
  @@index([sessionId])
  @@index([candidateId])
  @@index([postId])
}

// ===================== Part 7A: Auth =====================

model User {
  id           String     @id @default(uuid())
  name         String
  username     String     @unique
  passwordHash String
  role         Role
  isActive     Boolean    @default(true)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
}

model CandidateAccess {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ===================== Part 7C: Expert questions =====================

model ExpertQuestionScore {
  id           String   @id @default(uuid())
  userId       String // examiner who injected
  sessionId    String
  questionId   String
  avgRelevancy Float
  countAsked   Int
  countLowFit  Int
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([questionId])
}
