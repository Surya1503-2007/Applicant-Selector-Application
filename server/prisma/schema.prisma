// Prisma Schema for RAC DRDO Adaptive Interview System
// Part 1: Normalized Question Bank & Interview Session Foundation
// Part 2: Skill-Match Suitability Engine
// Part 3: Answer Scorer & Evaluation Engine
// Part 4: Adaptive Interview Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Difficulty levels for interview questions
enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Categorization of question purpose and assessment domain
enum LevelTag {
  TECHNICAL
  MANAGERIAL
  ICEBREAKER
}

/// Subject domain being evaluated (e.g., ASD - Advanced System Development)
model Subject {
  id        String    @id @default(uuid())
  name      String    @unique
  topics    Topic[]
  posts     Post[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Core functional topic under a subject (e.g., Requirements Analysis, System Architecture)
model Topic {
  id        String     @id @default(uuid())
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name      String
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([subjectId, name])
}

/// Single Question model supporting adaptive follow-ups, keywords, difficulty tiers, and simplified rephrasings
model Question {
  id             String      @id @default(uuid())
  topicId        String?
  topic          Topic?      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  difficulty     Difficulty
  questionText   String      @db.Text
  simplifiedText String?     @db.Text // Simpler rephrasing used when candidate answer is IRRELEVANT
  idealAnswer    String      @db.Text
  keywords       String[]
  parentQId      String?
  parentQuestion Question?   @relation("QuestionFollowUps", fields: [parentQId], references: [id], onDelete: SetNull)
  followUps      Question[]  @relation("QuestionFollowUps")
  levelTag       LevelTag
  responses      Response[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([topicId, difficulty])
  @@index([parentQId])
  @@index([difficulty])
  @@index([levelTag])
}

/// Candidate interviewed for Scientist/Engineer posts at RAC DRDO
model Candidate {
  id                String             @id @default(uuid())
  name              String
  postApplied       String
  experienceLevel   String
  sessions          Session[]
  skills            CandidateSkill[]
  skillMatchResults SkillMatchResult[]
  reports           Report[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

/// An interview session conducted for a candidate
model Session {
  id           String        @id @default(uuid())
  candidateId  String
  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  startTime    DateTime      @default(now())
  endTime      DateTime?
  responses    Response[]
  sessionState SessionState?
  decisionLogs DecisionLog[]
  reports      Report[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([candidateId])
}

/// Candidate's response to an individual question in an interview session
model Response {
  id               String    @id @default(uuid())
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answerText       String    @db.Text
  relevancyScore   Float?
  correctnessScore Float?
  answerScore      Float?
  verdict          String?
  breakdown        Json?
  isReask          Boolean   @default(false) // Tracks whether this was a simplified re-ask
  timestamp        DateTime  @default(now())

  // Permits exactly one normal ask (isReask=false) and at most one tracked simplified re-ask (isReask=true) per session
  @@unique([sessionId, questionId, isReask])
  @@index([sessionId])
  @@index([questionId])
}

// =========================================================================
// PART 2: Skill-Match Suitability Models
// =========================================================================

/// Job opening / post at RAC DRDO (e.g. Scientist C - Advanced System Development)
model Post {
  id                String             @id @default(uuid())
  title             String
  subjectId         String
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  level             String
  postSkills        PostSkill[]
  skillMatchResults SkillMatchResult[]
  reports           Report[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([subjectId])
}

/// Individual skill requirement defined for a post, with weighting and mandatory designation
model PostSkill {
  id          String   @id @default(uuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  skillName   String
  weight      Int      // 1 to 5
  isMandatory Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([postId, skillName])
  @@index([postId])
}

/// Skill profile item claimed or verified for a candidate
model CandidateSkill {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillName   String
  createdAt   DateTime  @default(now())

  @@unique([candidateId, skillName])
  @@index([candidateId])
}

/// Persisted audit record of a candidate's skill match evaluation against a post
model SkillMatchResult {
  id           String    @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  matchPercent Float
  band         String    // "STRONG" | "MODERATE" | "WEAK"
  breakdown    Json      // Explainable per-skill details, strengths, gaps, missing mandatory
  createdAt    DateTime  @default(now())

  @@index([candidateId])
  @@index([postId])
}

// =========================================================================
// PART 4: Adaptive Interview Engine Models
// =========================================================================

/// State machine tracker for an active adaptive interview session
model SessionState {
  id                    String      @id @default(uuid())
  sessionId             String      @unique
  session               Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  currentTopicId        String?
  currentDifficulty     Difficulty?
  currentQuestionId     String?
  phase                 String      @default("ICEBREAKER") // ICEBREAKER | TECHNICAL | COMPLETED
  technicalCount        Int         @default(0)
  icebreakerCount       Int         @default(0)
  consecutiveIrrelevant Int         @default(0)
  topicProgress         Json        @default("{}") // { [topicId]: { easyAsked, mediumAsked, hardAsked, finished, lastVerdict, reaskUsed } }
  status                String      @default("ACTIVE") // ACTIVE | COMPLETED
  endReason             String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

/// Explainable decision log tracking every state machine transition
model DecisionLog {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  step           Int
  questionId     String?
  verdict        String?  // IRRELEVANT | PARTIAL | STRONG | NOT_SCORED
  fromDifficulty String?  // EASY | MEDIUM | HARD
  toDifficulty   String?  // EASY | MEDIUM | HARD
  action         String   // NEXT_HARDER | NEXT_SAME | NEXT_EASIER | REASK_SIMPLIFIED | NEXT_TOPIC | ICEBREAKER | END
  reason         String   @db.Text
  createdAt      DateTime @default(now())

  @@index([sessionId])
  @@index([sessionId, step])
}

// =========================================================================
// PART 5: Session Report and Final Scoring Models
// =========================================================================

/// Comprehensive, immutable assessment report snapshot generated upon interview completion
/// User accounts for examiners and admins
model User {
  id          String   @id @default(uuid())
  name        String
  username    String   @unique
  passwordHash String
  role        Role
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  auditLogs   AuditLog[]
}

enum Role {
  ADMIN
  EXAMINER
}

/// Audit log entries for critical actions
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entityType String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

/// One‑time token that a candidate uses to access their interview session
model CandidateAccess {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
}


  id                     String    @id @default(uuid())
  sessionId              String
  session                Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidateId            String
  candidate              Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  postId                 String
  post                   Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  version                Int       @default(1)
  generatedAt            DateTime  @default(now())
  configSnapshot         Json      // The config values used, so later changes never alter old reports
  skillMatchPercent      Float
  skillMatchBand         String
  mandatoryGap           Boolean
  missingMandatory       Json
  interviewScore         Float
  overallScore           Float
  systemRecommendation   String    // Computed, never edited
  finalRecommendation    String    // Equals system value unless the board overrides
  terminatedEarly        Boolean   @default(false)
  endReason              String?
  questionRelevancyScore Float
  questionRelevancyBand  String
  topicScores            Json
  questionTable          Json
  difficultyProgression  Json
  flags                  Json
  decisionLog            Json      // Snapshot of the Part 4 audit trail
  boardRemarks           String?   @db.Text
  overriddenBy           String?
  overriddenAt           DateTime?
  overrideReason         String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([sessionId, version])
  @@index([sessionId])
  @@index([candidateId])
  @@index([postId])
}
