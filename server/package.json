{
  "name": "rac-interview-server",
  "version": "1.0.0",
  "description": "RAC DRDO Adaptive Interview System - Backend Foundation, Question Bank & Skill-Match Module",
  "main": "src/services/questionService.js",
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "test:db": "node scripts/testDb.js",
    "test:skillmatch": "node scripts/testSkillMatch.js",
    "test:scorer": "node scripts/testScorer.js",
    "calibrate:scorer": "node scripts/calibrateScorer.js",
    "test:persistence": "node scripts/testScorePersistence.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "drdo",
    "rac",
    "interview-system",
    "asd",
    "systems-engineering",
    "adaptive-interview",
    "skill-match",
    "prisma",
    "postgresql"
  ],
  "author": "RAC DRDO Development Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "natural": "^8.2.6"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
