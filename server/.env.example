# Environment variables for RAC DRDO Adaptive Interview System (Server)

# PostgreSQL Database Connection URL
# Replace username, password, host, port, and database name as appropriate for your setup:
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public

# Server HTTP Port (defaults to 5050 to avoid macOS ControlCenter / AirPlay Receiver conflict on 5000)
PORT=5050

# Required in production. Generate a unique value with: openssl rand -base64 32
AUTH_JWT_SECRET="replace-with-a-unique-secret"
DATABASE_URL="postgresql://postgres:password@localhost:5432/rac_interview_db?schema=public"

# Default Admin credentials for initial database seed
ADMIN_EMAIL="admin@rac.drdo.in"
ADMIN_PASSWORD="Admin@RAC123"
